# Bix Social Console - DEPLOYMENT environment additions
# -----------------------------------------------------------------------------
# The VM's /opt/bix-learn-sm/.env is the SAME shape as the repo's root
# .env.example (FAL_KEY, OPENAI_API_KEY, YOUTUBE_API_KEY, YOUTUBE_CLIENT_ID,
# YOUTUBE_CLIENT_SECRET, CAPTIONS). Ship that file out-of-band (scp) — it is
# git-ignored and never committed.
#
# This file documents only the EXTRA settings that matter when running under
# systemd on the VM. Add DASHBOARD_TOKEN to .env; the rest are set by the unit
# files and listed here for reference.
# -----------------------------------------------------------------------------

# Dashboard auth — REQUIRED on the VM. If set, the server requires
#   Authorization: Bearer <token>
# on every /api/* request. The SPA prompts for it and stores it. Generate a
# long random value, e.g.:  openssl rand -hex 32
DASHBOARD_TOKEN=

# --- Set by deploy/systemd/bix-dashboard.service (do NOT put in .env) ---------
# NODE_ENV=production   # serve apps/web/dist + spawn built CLI (apps/cli/dist)
# PORT=8787             # bound on localhost; reach via SSH tunnel

# --- Optional overrides (defaults are fine on a single VM) --------------------
# BIX_ROOT=/opt/bix-learn-sm      # repo root holding data/, outputs/, assets/
# BIX_DB=/opt/bix-learn-sm/data/bix.db

# Note: dotenv loads .env with override:false, so systemd Environment= and real
# process env win over file values. Keep NODE_ENV/PORT in the unit, secrets in
# .env.
