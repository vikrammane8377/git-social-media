[Unit]
Description=Bix weekly current-events scan (OpenAI web search + holidays + calendar)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bix
Group=bix
WorkingDirectory=/opt/bix-learn-sm
EnvironmentFile=/opt/bix-learn-sm/.env
ExecStart=/usr/bin/node apps/cli/dist/index.js scan:events
