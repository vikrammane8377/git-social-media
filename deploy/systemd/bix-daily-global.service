[Unit]
Description=Bix daily Short — Global channel (script -> video -> captions -> public YouTube)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bix
Group=bix
WorkingDirectory=/opt/bix-learn-sm
EnvironmentFile=/opt/bix-learn-sm/.env
# Run the compiled CLI directly (no tsx). WorkingDirectory + dotenv resolve
# .env, data/, outputs/, assets/. run-daily is date-driven, skips already-
# published slots, and exits 0 on a quiet day.
ExecStart=/usr/bin/node apps/cli/dist/index.js run-daily --channel global --privacy public
