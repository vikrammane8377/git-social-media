[Unit]
Description=Fire the competitor-track daily Short (18:00 Europe/Madrid, DST auto)

[Timer]
# Spain observes DST: 18:00 local = 16:00 UTC (summer) / 17:00 UTC (winter).
# systemd resolves Europe/Madrid against current DST rules each day. Both daily
# timers still fire well inside the same UTC day, so run-daily's local-date
# selection stays correct with the VM clock in UTC.
OnCalendar=*-*-* 18:00:00 Europe/Madrid
# Catch a missed run after downtime (e.g. VM was off at the trigger time).
Persistent=true

[Install]
WantedBy=timers.target
