{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@bix/config": ["./packages/config/src/index.ts"],
      "@bix/storage": ["./packages/storage/src/index.ts"],
      "@bix/video": ["./packages/video/src/index.ts"],
      "@bix/higgsfield": ["./packages/higgsfield/src/index.ts"],
      "@bix/youtube": ["./packages/youtube/src/index.ts"],
      "@bix/events": ["./packages/events/src/index.ts"],
      "@bix/competitors": ["./packages/competitors/src/index.ts"],
      "@bix/scripts": ["./packages/scripts/src/index.ts"],
      "@bix/server": ["./packages/server/src/index.ts"],
      "@bix/captions": ["./packages/captions/src/index.ts"],
      "@bix/brand": ["./packages/brand/src/index.ts"]
    }
  }
}
